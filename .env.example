DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clinix_emr?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/clinix_emr?schema=public"

# For Supabase/Vercel:
# DATABASE_URL should use the pooled Supabase connection string.
# DIRECT_URL should use the direct connection or session pooler connection for migrations.

# Demo credentials created by `npm.cmd run prisma:seed`:
# doctor@clinix.local / demo123
# juan.patient@clinix.local / demo123
